# Stellar
VITE_STELLAR_NETWORK=TESTNET
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_RAMEN_VAULT_CONTRACT_ID=
VITE_STAMP_NFT_CONTRACT_ID=
VITE_EVENT_STREAM_URL=

# Optional hosted Gemini bridge. Never expose GEMINI_API_KEY in VITE_ variables.
VITE_GEMINI_PROXY_URL=/api/suzume
VITE_QUEST_REWARD_API=/api/claim-quest
VITE_JETPACK_REWARD_API=/api/claim-jetpack-reward

# Public Testnet merchant address which receives power-up payments made in Freighter.
VITE_JETPACK_STORE_ADDRESS=

# Server-side only (Vercel function)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Testnet-only side-quest bounty treasury. Keep this server-side; never prefix it with VITE_.
# Fund its public address via Friendbot before trying reward claims.
QUEST_REWARD_SECRET=
QUEST_REWARD_XLM=1

# Testnet-only ramen delivery reward treasury. This secret must never be exposed to the browser.
JETPACK_REWARD_SECRET=
JETPACK_REWARD_XLM=0.35
